    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query": "^5.101.3",
    "@wagmi/core": "^3.6.3",
    "clsx": "^2.1.1",
    "next": "14.2.35",
    "next-themes": "^0.4.6",
    "postcss": "^8.5.19",
    "react": "^18.3.1",
