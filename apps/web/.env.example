# copy to .env.local and fill in the Reown id.

# https://dashboard.reown.com (required)
NEXT_PUBLIC_REOWN_PROJECT_ID=

# mainnet | hardhat | mainnet-fork | sepolia. Empty follows NODE_ENV: hardhat in development, mainnet in production.
# mainnet-fork is a local node forking Ethereum (yarn local-node:contracts:mainnet-fork), answering as chainId 1.
NEXT_PUBLIC_CHAIN=

# Ethereum RPC (optional); empty uses https://rpc.mevblocker.io. Ignored on mainnet-fork.
NEXT_PUBLIC_MAINNET_RPC=

# Sepolia RPC (optional, sepolia mode only); empty uses https://ethereum-sepolia-rpc.publicnode.com
NEXT_PUBLIC_SEPOLIA_RPC=

# The local node for hardhat and mainnet-fork (optional); empty uses http://127.0.0.1:8545
NEXT_PUBLIC_LOCAL_RPC_URL=

# AppKit metadata (optional)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Organisers whose events the home page lists, comma-separated (empty on mainnet = none listed)
