# Mainnet-fork simulations (yarn local-stack mainnet-fork, yarn test:fork).
# Copy to .env.mainnet-fork and set a keyed archive-capable RPC; fork suites skip while it is empty.
MAINNET_FORK_RPC_URL=
# Optional pin; empty forks at the latest block. The live event was deployed at 26290226.
MAINNET_FORK_BLOCK=
