{
  "$schema": "https://turborepo.dev/schema.json",
  "globalEnv": ["CI", "NODE_ENV"],
  "//": "MAINNET_FORK_* configure the fork suites, which skip when MAINNET_FORK_RPC_URL is unset.",
  "globalPassThroughEnv": ["MAINNET_FORK_RPC_URL", "MAINNET_FORK_BLOCK", "FORK_RPC_URL", "E2E_BASE_URL"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["NEXT_PUBLIC_*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", "artifacts/**", "generated/**"]
    },
    "dev": { "cache": false, "persistent": true },
    "lint": { "dependsOn": ["^lint"] },
    "format": {},
    "format:check": {},
    "test": { "dependsOn": ["^build"], "env": ["TZ"] },
    "check-types": { "dependsOn": ["^build"] }
  }
}
