    "@kickback/prettier-config": "workspace:*",
    "@kickback/typescript-config": "workspace:*",
    "@types/node": "^22.15.30",
    "eslint": "^9.28.0",
    "prettier": "^3.7.4",
    "typescript": "^5.8.3",
    "vitest": "^4.1.0"
  },
  "prettier": "@kickback/prettier-config",
  "volta": {
    "extends": "../../package.json"
  }
